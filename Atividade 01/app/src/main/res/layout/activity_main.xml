<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        >

        <EditText
            android:id="@+id/salarioInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Salário (R$)"
            android:width="100pt"
            android:inputType="numberDecimal"
            android:textSize="20sp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salário Mensal"
            android:textColor="#979797"
            android:textSize="16sp"
            android:textAlignment="center"
            />

        <EditText
            android:id="@+id/gastoInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gastos (R$)"
            android:width="100pt"
            android:inputType="numberDecimal"
            android:textSize="20sp"
            android:layout_marginTop="16dp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gastos com saúde e educação"
            android:textColor="#979797"
            android:textSize="16sp"
            android:textAlignment="center"
            />

        <EditText
            android:id="@+id/dependentesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número de dependentes"
            android:width="100pt"
            android:inputType="number"
            android:textSize="20sp"
            android:layout_marginTop="16dp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número de Dependentes"
            android:textColor="#979797"
            android:textSize="16sp"
            android:textAlignment="center"
            />

        <Button
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular"
            android:backgroundTint="#BB00FF"
            android:textSize="20dp"
            android:layout_marginTop="16dp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SEU IMPOSTO DE RENDA MENSAL:"
            android:textColor="#979797"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="R$"
                android:layout_marginRight="4dp"
                android:textSize="30dp"
                android:textColor="#00B0FB"
                />
            <TextView
                android:id="@+id/tax"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="0.00"
                android:textSize="30dp"
                android:textColor="#00B0FB"
                />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>