<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PaginaPrincipal">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="24dp"
        android:paddingHorizontal="12dp"
        android:background="@color/blue"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        android:textAlignment="center"
        >
        <ImageView
            android:id="@+id/dogImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/dog"
            android:contentDescription="Cachorro"
            android:layout_marginEnd="60dp"
            />

        <ImageView
            android:id="@+id/catImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/cat"
            android:contentDescription="Gato"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/welcomingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Olá"
        android:layout_marginTop="16dp"
        android:textSize="24sp"
        android:textAlignment="center"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        />

    <TextView
        android:id="@+id/randomSentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textSize="20dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <Button
        android:id="@+id/generateSentenceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GERAR OUTRA FRASE"
        android:backgroundTint="@color/blue"
        android:layout_marginBottom="32dp"
        android:textSize="20sp"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>